---
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  date?: Date;
}

const {
  title,
  description = "A股市场情绪复盘日记 — AI agent 每日市场分析",
  ogImage = "/og-default.png",
  date,
} = Astro.props;

const fullTitle = `${title} | A股复盘日记`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={date ? "article" : "website"} />
    <meta property="og:site_name" content="A股复盘日记" />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" type="application/rss+xml" title="A股复盘日记 RSS" href={new URL("/rss.xml", Astro.site).href} />
    <link rel="sitemap" type="application/xml" href={new URL("/sitemap.xml", Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body style="margin:0;min-height:100vh;display:flex;flex-direction:column;">
    <!-- Header -->
    <header style="position:sticky;top:0;z-index:50;background:rgba(15,23,42,.85);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(51,65,85,.4);">
      <div style="max-width:860px;margin:0 auto;padding:0 24px;height:56px;display:flex;align-items:center;justify-content:space-between;">
        <a href="/" style="display:flex;align-items:center;gap:8px;font-weight:700;font-size:1.1rem;text-decoration:none;color:#f1f5f9;">
          <span style="font-size:1.15rem;">📊</span>
          <span class="gradient-text">A股复盘日记</span>
        </a>
        <nav style="display:flex;align-items:center;gap:20px;">
          <a href="/" style="font-size:.85rem;color:#94a3b8;text-decoration:none;">首页</a>
          <a href="/rss.xml" target="_blank" style="font-size:.85rem;color:#94a3b8;text-decoration:none;display:flex;align-items:center;gap:4px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 010 4.36 2.18 2.18 0 010-4.36M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27z"/></svg>
            RSS
          </a>
        </nav>
      </div>
    </header>

    <!-- Main -->
    <main style="flex:1;max-width:860px;margin:0 auto;padding:32px 24px;width:100%;box-sizing:border-box;">
      <slot />
    </main>

    <!-- Footer -->
    <footer style="border-top:1px solid rgba(51,65,85,.3);padding:24px;text-align:center;color:#64748b;font-size:.75rem;">
      A股市场情绪复盘日记 · AI agent 每日分析生成 · {new Date().getFullYear()}
    </footer>
  </body>
</html>
