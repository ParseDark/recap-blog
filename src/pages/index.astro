---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getDiaryEntries,
  groupByMonth,
  formatShortDate,
} from "../utils/diary";

const entries = getDiaryEntries();
const grouped = groupByMonth(entries);

const monthNames: Record<string, string> = {
  "01": "一月", "02": "二月", "03": "三月", "04": "四月",
  "05": "五月", "06": "六月", "07": "七月", "08": "八月",
  "09": "九月", "10": "十月", "11": "十一月", "12": "十二月",
};

const dailyCount = entries.filter(e => e.type === "daily").length;
const intradayCount = entries.filter(e => e.type === "intraday").length;
const candidatesCount = entries.filter(e => e.type === "candidates").length;
const latestEntry = entries[0];
---

<BaseLayout title="首页" description="A股市场情绪复盘日记">
  <!-- Hero -->
  <section class="max-w-app" style="margin-bottom:3rem;">
    <div class="hero-card">
      <div style="position:relative;">
        <h1 style="font-size:2rem;font-weight:800;margin:0 0 .25rem;color:var(--fg);letter-spacing:-.02em;">
          A股市场情绪 <span style="color:var(--accent);">复盘日记</span>
        </h1>
        <p style="color:var(--muted-fg);max-width:520px;line-height:1.7;margin:.5rem 0 0;">
          AI agent 每日自动生成的市场分析报告，覆盖市场广度、板块轮动、资金方向、连板生态与交易决策。
        </p>
        <div style="display:flex;gap:2rem;margin-top:1.25rem;">
          <div>
            <span style="font-size:1.3rem;font-weight:700;color:var(--fg);">{dailyCount}</span>
            <span style="font-size:.75rem;color:var(--muted-fg);margin-left:4px;">篇复盘</span>
          </div>
          <div>
            <span style="font-size:1.3rem;font-weight:700;color:var(--fg);">{intradayCount}</span>
            <span style="font-size:.75rem;color:var(--muted-fg);margin-left:4px;">盘中</span>
          </div>
          <div>
            <span style="font-size:1.3rem;font-weight:700;color:var(--fg);">{candidatesCount}</span>
            <span style="font-size:.75rem;color:var(--muted-fg);margin-left:4px;">候选池</span>
          </div>
          {latestEntry && (
            <div style="margin-left:auto;font-size:.8rem;color:var(--muted-fg);">
              最新：{latestEntry.year}-{latestEntry.month}-{latestEntry.day}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Archives -->
  {
    entries.length === 0 ? (
      <div class="max-w-app" style="text-align:center;padding:4rem 0;color:var(--muted-fg);">
        <p>暂无复盘日记</p>
      </div>
    ) : (
      [...grouped.entries()].map(([monthKey, monthEntries]) => {
        const [year, month] = monthKey.split("-");
        const label = `${year}年${monthNames[month] || `${month}月`}`;
        return (
          <section class="max-w-app" style="margin-bottom:2.5rem;">
            <h2 style="font-size:1rem;font-weight:600;color:var(--fg);margin:0 0 1rem;">
              {label}
              <span style="font-size:.75rem;color:var(--muted-fg);margin-left:8px;">{monthEntries.length} 篇</span>
            </h2>
            <div style="border:1px solid var(--border);border-radius:.75rem;overflow:hidden;">
              {monthEntries.map((entry, idx) => (
                <a href={`/diary/${entry.slug}`} class="post-card">
                  <span style="font-size:.8rem;color:var(--muted-fg);font-family:monospace;min-width:44px;">
                    {formatShortDate(entry.month, entry.day)}
                  </span>
                  <span style="font-size:.9rem;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                    {entry.title || `${entry.year}-${entry.month}-${entry.day} 复盘`}
                  </span>
                  {entry.type !== "daily" && (
                    <span class="badge">
                      {entry.type === "intraday" ? "盘中"
                        : entry.type === "watchlist" ? "观察"
                        : entry.type === "quantile" ? "资金分位" : "候选"}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </section>
        );
      })
    )
  }
</BaseLayout>
