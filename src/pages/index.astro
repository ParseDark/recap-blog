---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getDiaryEntries,
  groupByMonth,
  formatShortDate,
} from "../utils/diary";

const entries = getDiaryEntries();
const grouped = groupByMonth(entries);

const monthNames: Record<string, string> = {
  "01": "一月", "02": "二月", "03": "三月", "04": "四月",
  "05": "五月", "06": "六月", "07": "七月", "08": "八月",
  "09": "九月", "10": "十月", "11": "十一月", "12": "十二月",
};

const dailyCount = entries.filter(e => e.type === "daily").length;
const intradayCount = entries.filter(e => e.type === "intraday").length;
const candidatesCount = entries.filter(e => e.type === "candidates").length;
const latestEntry = entries[0];
---

<BaseLayout
  title="首页"
  description="A股市场情绪复盘日记 — AI agent 每日市场分析"
>
  <!-- Hero Card -->
  <section style="margin-bottom:48px;">
    <div class="glass" style="border-radius:16px;padding:40px;position:relative;overflow:hidden;">
      <div style="position:absolute;top:-40px;right:-40px;width:200px;height:200px;background:rgba(59,130,246,.06);border-radius:50%;filter:blur(60px);"></div>
      <div style="position:relative;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
          <span class="badge badge-green">● 运行中</span>
          <span style="font-size:.8rem;color:#64748b;">最后更新：{latestEntry?.year}-{latestEntry?.month}-{latestEntry?.day}</span>
        </div>
        <h1 style="font-size:2rem;font-weight:800;color:#f8fafc;margin:0 0 8px;letter-spacing:-.02em;">
          A股市场情绪 <span class="gradient-text">复盘日记</span>
        </h1>
        <p style="color:#94a3b8;font-size:.95rem;max-width:480px;line-height:1.7;margin:0;">
          AI agent 每日自动生成的市场分析报告。覆盖总量体检、板块轮动、资金方向、连板生态与交易决策。
        </p>
        <div style="display:flex;gap:32px;margin-top:20px;">
          <div>
            <span style="font-size:1.5rem;font-weight:700;color:#e2e8f0;">{dailyCount}</span>
            <span style="font-size:.75rem;color:#64748b;margin-left:4px;">篇复盘</span>
          </div>
          <div>
            <span style="font-size:1.5rem;font-weight:700;color:#e2e8f0;">{intradayCount}</span>
            <span style="font-size:.75rem;color:#64748b;margin-left:4px;">盘中记录</span>
          </div>
          <div>
            <span style="font-size:1.5rem;font-weight:700;color:#e2e8f0;">{candidatesCount}</span>
            <span style="font-size:.75rem;color:#64748b;margin-left:4px;">候选池</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Archives -->
  {
    entries.length === 0 ? (
      <div style="text-align:center;padding:64px 0;color:#64748b;">
        <div style="font-size:2rem;margin-bottom:12px;">📭</div>
        <p style="margin:0;">暂无复盘日记</p>
        <p style="font-size:.8rem;margin:4px 0 0;">第一个交易日结束后会自动生成</p>
      </div>
    ) : (
      [...grouped.entries()].map(([monthKey, monthEntries]) => {
        const [year, month] = monthKey.split("-");
        const label = `${year}年${monthNames[month] || `${month}月`}`;
        return (
          <section style="margin-bottom:40px;">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
              <h2 style="font-size:1.05rem;font-weight:600;color:#e2e8f0;margin:0;">{label}</h2>
              <span style="font-size:.75rem;color:#475569;">{monthEntries.length} 篇</span>
            </div>
            <div class="glass" style="border-radius:12px;overflow:hidden;">
              {monthEntries.map((entry, idx) => {
                const href = `/diary/${entry.slug}`;
                return (
                  <a
                    href={href}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "12px",
                      padding: "12px 20px",
                      textDecoration: "none",
                      borderBottom: idx < monthEntries.length - 1 ? "1px solid rgba(51,65,85,.3)" : "none",
                      transition: "background .15s",
                    }}
                  >
                    <span style="font-size:.8rem;color:#64748b;font-family:var(--font-mono);min-width:44px;">
                      {formatShortDate(entry.month, entry.day)}
                    </span>
                    <span style="font-size:.9rem;color:#cbd5e1;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                      {entry.title || `${entry.year}-${entry.month}-${entry.day} 复盘`}
                    </span>
                    {entry.type === "intraday" && <span class="badge badge-purple">盘中</span>}
                    {entry.type === "candidates" && <span class="badge badge-yellow">候选</span>}
                    {entry.type === "daily" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" style="flex-shrink:0;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                      </svg>
                    )}
                  </a>
                );
              })}
            </div>
          </section>
        );
      })
    )
  }
</BaseLayout>
